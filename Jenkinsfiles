pipeline {
    agent any

    stages {

        stage('install') {
            steps {
                bat 'npm install'
            }
        }

        stage('run App') {
            steps {
                bat 'node index.js'
            }
        }

        stage('test') {
            steps {
                bat 'echo Tests passed successfully'
            }
        }
        stage('Check Docker') {
            steps {
                bat '"C:/Users/HP/AppData/Local/Programs/DockerDesktop/resources/bin/docker.exe" --version'
            }
        }
        stage('Build docker Image') {
            steps {
                bat '"C:/Users/HP/AppData/Local/Programs/DockerDesktop/resources/bin/docker.exe" build -t node-app .'
            }
        }
         stage('Run docker container') {
            steps {
                bat '"C:/Users/HP/AppData/Local/Programs/DockerDesktop/resources/bin/docker.exe" run -d -p 3000:3000 --name node-add-container node-app'
            }
         }
         stage('docker container logs') {
            steps {
                bat '"C:/Users/HP/AppData/Local/Programs/DockerDesktop/resources/bin/docker.exe" logs node-add-container'
            }
         }
    }
}
